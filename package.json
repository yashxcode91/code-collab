{
  "name": "codecollab",
  "version": "1.0.0",
  "private": true,
  "description": "CodeCollab - Advanced Real-Time Developer Platform",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "pnpm --filter \"./apps/*\" --parallel dev",
    "build": "pnpm --filter \"./packages/*\" --if-present run build && pnpm --filter \"./apps/*\" --if-present run build",
    "lint": "pnpm --filter \"*\" lint",
    "test": "pnpm --filter \"*\" test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:load": "pnpm --filter server exec tsx ../../scripts/load-test-realtime.ts",
    "db:migrate:prod": "pnpm --filter @codecollab/database migrate:deploy"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "typescript": "^5.7.3"
  }
}
