# =====================================================================
# Devnolith Studio Day 14 Production Environment Configuration Template
# Copy this file to `.env.production` and generate cryptographically secure keys.
# NEVER commit production `.env.production` to source control.
# =====================================================================

# -------------------------------------------------------------
# 1. Environment & Network Routing
# -------------------------------------------------------------
NODE_ENV=production
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443

# Public domain or URL of your frontend (used for CORS and CSRF origin checks)
# e.g. https://devnolith.yourdomain.com or http://localhost
FRONTEND_ORIGIN=http://localhost

# -------------------------------------------------------------
# 2. Database Infrastructure (PostgreSQL 16 + pgvector)
# -------------------------------------------------------------
POSTGRES_USER=postgres
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=replace_with_strong_production_postgres_password_min_32_chars
POSTGRES_DB=devnolith_prod

# -------------------------------------------------------------
# 3. Cache & Messaging (Redis 7 Alpine)
# -------------------------------------------------------------
# Generate with: openssl rand -hex 24
REDIS_PASSWORD=replace_with_strong_production_redis_password_min_32_chars

# -------------------------------------------------------------
# 4. Cryptographic Authentication & Session Tokens
# Minimum 32 characters; generated via: openssl rand -base64 48
# -------------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_high_entropy_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_high_entropy_jwt_refresh_secret_min_32_chars
CSRF_SECRET=replace_with_high_entropy_csrf_secret_min_32_chars
EXECUTION_PUBSUB_SECRET=replace_with_high_entropy_pubsub_secret_min_32_chars

# -------------------------------------------------------------
# 5. AI Assistant & Code Intelligence (Optional / On-Demand)
# -------------------------------------------------------------
GEMINI_API_KEY=

# -------------------------------------------------------------
# 6. Third-Party OAuth 2.0 Identity Providers (Optional)
# -------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
