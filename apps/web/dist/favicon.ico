<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" role="img" aria-labelledby="title desc">
  <title id="title">Devnolith</title>
  <desc id="desc">Orange dimensional open-ribbon D symbol with centered code brackets.</desc>
  <defs>
    <linearGradient id="body" x1=".12" y1=".05" x2=".92" y2=".92">
      <stop offset="0" stop-color="#FFB52C"/>
      <stop offset=".48" stop-color="#FF9208"/>
      <stop offset="1" stop-color="#E85A00"/>
    </linearGradient>
    <linearGradient id="top" x1=".05" y1=".05" x2=".95" y2=".9">
      <stop offset="0" stop-color="#FFC044"/>
      <stop offset=".42" stop-color="#FF9C0A"/>
      <stop offset="1" stop-color="#F47A00"/>
    </linearGradient>
    <linearGradient id="left" x1="0" y1="0" x2=".1" y2="1">
      <stop offset="0" stop-color="#9D3500"/>
      <stop offset=".5" stop-color="#E65A00"/>
      <stop offset="1" stop-color="#FFD35F"/>
    </linearGradient>
    <linearGradient id="right" x1=".1" y1="0" x2=".9" y2=".8">
      <stop offset="0" stop-color="#FF9B0C"/>
      <stop offset=".55" stop-color="#F36B00"/>
      <stop offset="1" stop-color="#B93E00"/>
    </linearGradient>
    <linearGradient id="bottom" x1=".1" y1=".15" x2=".9" y2=".85">
      <stop offset="0" stop-color="#FFD05A"/>
      <stop offset=".4" stop-color="#FF970B"/>
      <stop offset="1" stop-color="#DC4D00"/>
    </linearGradient>
    <linearGradient id="code" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FFA00B"/>
      <stop offset="1" stop-color="#E95E00"/>
    </linearGradient>
    <filter id="shadow" x="-25%" y="-20%" width="150%" height="155%">
      <feGaussianBlur in="SourceAlpha" stdDeviation="7"/>
      <feOffset dy="7"/>
      <feComponentTransfer><feFuncA type="linear" slope=".32"/></feComponentTransfer>
      <feMerge><feMergeNode/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
  </defs>

  <rect width="512" height="512" fill="#0D0A08"/>

  <g transform="translate(-83 -4) scale(.88)" filter="url(#shadow)">
    <!-- Full continuous ribbon silhouette -->
    <path d="M190 151
      C190 140 196 132 207 126 L278 98
      C290 93 301 94 312 101 L548 230
      C565 239 573 253 573 272 L573 428
      C573 447 564 462 547 472 L392 557
      C380 564 372 565 358 565 L190 565
      L434 420 C446 412 457 414 468 421 L482 430
      C491 435 495 443 495 454 L495 330
      C495 316 488 304 476 297 L309 203
      C303 199 299 201 299 210 L299 381
      C299 393 293 400 283 406 L190 465 Z"
      fill="url(#body)"/>

    <!-- Top face of the folded ribbon -->
    <path d="M190 151
      C190 140 196 132 207 126 L278 98
      C290 93 301 94 312 101 L548 230
      C565 239 573 253 573 272
      L495 330
      C495 316 488 304 476 297 L309 203
      C303 199 299 201 299 210
      L190 151 Z"
      fill="url(#top)"/>

    <!-- Inner left wall: one broad, slanted quadrilateral face -->
    <path d="M190 151 L309 203
      C303 199 299 201 299 210
      L299 381 C299 393 293 400 283 406
      L190 465 Z"
      fill="url(#left)"/>

    <!-- Right upright of the D -->
    <path d="M548 230
      C565 239 573 253 573 272 L573 428
      C573 447 564 462 547 472 L495 502
      L495 454 C495 443 491 435 482 430
      L468 421 L476 297 Z"
      fill="url(#right)" opacity=".92"/>

    <!-- Lower return of the ribbon -->
    <path d="M190 565 L358 565
      C372 565 380 564 392 557 L547 472
      L495 502 L495 454
      C495 443 491 435 482 430 L468 421
      C457 414 446 412 434 420 Z"
      fill="url(#bottom)"/>

    <!-- Subtle illuminated outer edges -->
    <path d="M207 126 L278 98 C290 93 301 94 312 101 L548 230"
      fill="none" stroke="#FFD36C" stroke-width="2.8" stroke-linecap="round" opacity=".78"/>
    <path d="M190 151 L190 465"
      fill="none" stroke="#FFB52D" stroke-width="2" opacity=".35"/>

    <!-- Angular code glyph centered in the D opening -->
    <g fill="url(#code)">
      <path d="M372 333 L334 357 L372 384 L374 366 L360 357 L373 348 Z"/>
      <path d="M432 333 L430 348 L445 357 L430 366 L432 384 L468 357 Z"/>
      <path d="M414 316 L381 401 L398 401 L422 316 Z"/>
    </g>
  </g>
</svg>
