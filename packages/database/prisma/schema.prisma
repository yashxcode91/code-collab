// =====================================================================
// Prisma Configuration & Enums
// Defines our PostgreSQL connection, TypeScript client generator, and
// strictly typed domain enums shared with backend validation.
// =====================================================================

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x", "darwin-arm64", "debian-openssl-3.0.x"]
}

// Global platform role (user vs site admin)
enum UserRole {
  ADMIN
  USER
}

// External OAuth login providers linked to a User
enum AuthProvider {
  GOOGLE
  GITHUB
}

// Supported languages for workspace starter files & Monaco highlighting
enum SupportedLanguage {
  JAVASCRIPT
  TYPESCRIPT
  PYTHON
  CPP
  JAVA
}

// Collaborator RBAC role inside a single workspace
enum ProjectRole {
  OWNER
  EDITOR
  VIEWER
}

// Tree item type inside a branch file explorer
enum FileNodeType {
  FILE
  FOLDER
}

// Per-user, per-file/folder access override set by a workspace owner
enum FileAccessPermission {
  EDIT
  READ_ONLY
  DENIED
}

// Authoritative lifecycle state for sandboxed Docker code executions
enum ExecutionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  TIMEOUT
  CANCELLED
}

// Distinguishes collaborator chat messages from automatic workspace system events
enum ChatMessageType {
  USER
  SYSTEM
}

// Participant role inside an AI conversation turn
enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// Interactive capability/action requested from the AI assistant
enum AiActionKind {
  CHAT
  EXPLAIN
  DEBUG
  GENERATE_TESTS
  REVIEW
  REFACTOR
}

// Processing state of an asynchronous codebase embedding indexing job
enum IndexTaskStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Lifecycle state of an autonomous multi-file agent session
enum AgentSessionStatus {
  PLANNING
  EXECUTING
  VERIFYING
  SELF_HEALING
  AWAITING_REVIEW
  COMPLETED
  FAILED
  CANCELLED
}

// State machine status of an individual execution plan step
enum AgentStepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

// Execution status of an individual agent tool call
enum AgentToolStatus {
  RUNNING
  SUCCESS
  ERROR
}

// Type of file mutation staged by an autonomous agent
enum AgentFileChangeType {
  CREATE
  MODIFY
  DELETE
}

// Core user identity; supports password auth, OAuth-only accounts, or both
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String? // Null for OAuth-only users (e.g. Google sign-in)
  avatarUrl    String?
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts            Account[]
  ownedProjects       Project[]           @relation("ProjectOwner")
  projectMembers      ProjectMember[]
  createdBranches     ProjectBranch[]     @relation("BranchCreator")
  lockedFiles         ProjectFile[]       @relation("FileLockHolder")
  fileAccesses        ProjectFileAccess[]
  executionRuns       ExecutionRun[]
  chatMessages        ChatMessage[]
  createdSnapshots    BranchSnapshot[]    @relation("SnapshotCreator")
  aiConversations     AiConversation[]    @relation("AiConversationOwner")
  requestedIndexTasks CodebaseIndexTask[] @relation("IndexTaskRequester")
  agentSessions       AgentSession[]      @relation("AgentSessionOwner")

  @@map("users")
}

// External OAuth provider identity linked to a local User (1 User : N Accounts)
model Account {
  id                String       @id @default(uuid())
  userId            String
  provider          AuthProvider
  providerAccountId String // Permanent unique user ID from Google/GitHub
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

// Collaborative Studio workspace housing members, Git-style branches, and live cursor limits
model Project {
  id                   String            @id @default(uuid())
  name                 String
  description          String?
  ownerId              String
  language             SupportedLanguage @default(TYPESCRIPT)
  isPublic             Boolean           @default(false)
  maxConcurrentEditors Int               @default(5)
  preventSameLineEdit  Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  owner           User                @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members         ProjectMember[]
  branches        ProjectBranch[]
  executionRuns   ExecutionRun[]
  aiConversations AiConversation[]
  embeddings      CodebaseEmbedding[]
  indexTasks      CodebaseIndexTask[]
  agentSessions   AgentSession[]
  ChatMessage     ChatMessage[]
  BranchSnapshot  BranchSnapshot[]
  previewSandboxes PreviewSandbox[]

  @@index([ownerId])
  @@map("projects")
}

// Join table assigning each collaborator a single ProjectRole per workspace
model ProjectMember {
  id        String      @id @default(uuid())
  projectId String
  userId    String
  role      ProjectRole @default(EDITOR)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

// Git-style branch isolating an independent snapshot/copy of files inside a Project
model ProjectBranch {
  id             String   @id @default(uuid())
  projectId      String
  name           String
  isDefault      Boolean  @default(false)
  isProtected    Boolean  @default(false)
  parentBranchId String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentBranch    ProjectBranch?      @relation("BranchParent", fields: [parentBranchId], references: [id], onDelete: SetNull)
  childBranches   ProjectBranch[]     @relation("BranchParent")
  createdBy       User?               @relation("BranchCreator", fields: [createdById], references: [id], onDelete: SetNull)
  files           ProjectFile[]
  executionRuns   ExecutionRun[]
  aiConversations AiConversation[]
  embeddings      CodebaseEmbedding[]
  indexTasks      CodebaseIndexTask[]
  agentSessions   AgentSession[]
  ChatMessage     ChatMessage[]
  BranchSnapshot  BranchSnapshot[]
  previewSandboxes PreviewSandbox[]

  @@unique([projectId, name])
  @@unique([id, projectId])
  @@index([projectId])
  @@map("project_branches")
}

// Self-referencing file/folder tree node living on one ProjectBranch
model ProjectFile {
  id         String       @id @default(uuid())
  branchId   String
  parentId   String?
  parentKey  String       @default("ROOT") // Matches parentId or "ROOT" for PG root uniqueness
  name       String
  nodeType   FileNodeType @default(FILE)
  content    String       @default("") @db.Text
  version    Int          @default(1) // Optimistic Concurrency Control for REST updates
  yjsState   Bytes? // Binary Y.Doc snapshot reserved for Steps 7-8 multi-cursor CRDT
  lockedById String?
  lockedAt   DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  branch        ProjectBranch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  parent        ProjectFile?        @relation("FileTree", fields: [parentId], references: [id], onDelete: Cascade)
  children      ProjectFile[]       @relation("FileTree")
  lockedBy      User?               @relation("FileLockHolder", fields: [lockedById], references: [id], onDelete: SetNull)
  accessRules   ProjectFileAccess[]
  executionRuns ExecutionRun[]
  chatMessages  ChatMessage[]
  aiMessages    AiMessage[]
  embeddings    CodebaseEmbedding[]

  @@unique([branchId, parentKey, name])
  @@unique([id, branchId])
  @@index([branchId, parentId])
  @@map("project_files")
}

// Fine-grained per-user ACL override on a specific file or folder (inherits down folders)
model ProjectFileAccess {
  id         String               @id @default(uuid())
  fileId     String
  userId     String
  permission FileAccessPermission
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  file ProjectFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([fileId, userId])
  @@index([userId])
  @@map("project_file_accesses")
}

// Persistent record for an isolated Docker code execution run (source of truth over Redis/BullMQ)
model ExecutionRun {
  id              String            @id @default(uuid())
  projectId       String
  branchId        String
  fileId          String?
  userId          String
  language        SupportedLanguage
  status          ExecutionStatus   @default(QUEUED)
  entryFileName   String
  sourceCode      String            @db.Text
  initialStdin    String?           @db.Text
  stdout          String            @default("") @db.Text
  stderr          String            @default("") @db.Text
  stdoutTruncated Boolean           @default(false)
  stderrTruncated Boolean           @default(false)
  exitCode        Int?
  failureKind     String?
  errorMessage    String?
  durationMs      Int?
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  branch  ProjectBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  file    ProjectFile?  @relation(fields: [fileId], references: [id], onDelete: SetNull)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, branchId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("execution_runs")
}

// Persistent real-time workspace chat message with optional code location anchor (`file:line`)
model ChatMessage {
  id         String          @id @default(uuid())
  projectId  String
  branchId   String?
  userId     String?
  fileId     String?
  type       ChatMessageType @default(USER)
  content    String          @db.Text
  fileName   String?
  lineNumber Int?
  createdAt  DateTime        @default(now())

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  branch  ProjectBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user    User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  file    ProjectFile?   @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt(sort: Desc)])
  @@map("chat_messages")
}

// Immutable point-in-time snapshot header for a branch's file/folder tree
model BranchSnapshot {
  id                     String   @id @default(uuid())
  projectId              String
  branchId               String
  createdById            String?
  title                  String
  description            String?  @db.Text
  restoredFromSnapshotId String?
  fileCount              Int      @default(0)
  totalBytes             Int      @default(0)
  createdAt              DateTime @default(now())

  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  branch    ProjectBranch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdBy User?                @relation("SnapshotCreator", fields: [createdById], references: [id], onDelete: SetNull)
  files     BranchSnapshotFile[]

  @@index([projectId, branchId, createdAt(sort: Desc)])
  @@index([branchId, createdAt(sort: Desc)])
  @@map("branch_snapshots")
}

// Normalized file/folder node captured inside a BranchSnapshot (never mutated after creation)
model BranchSnapshotFile {
  id             String       @id @default(uuid())
  snapshotId     String
  originalFileId String?
  path           String
  nodeType       FileNodeType @default(FILE)
  content        String       @default("") @db.Text
  sizeBytes      Int          @default(0)
  deniedUserIds  String[]     @default([])

  snapshot BranchSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, path])
  @@index([snapshotId])
  @@map("branch_snapshot_files")
}

// Multi-turn AI assistant conversation anchored to a workspace project and branch
model AiConversation {
  id        String   @id @default(uuid())
  projectId String
  branchId  String
  userId    String
  title     String   @default("New Conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  branch   ProjectBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user     User          @relation("AiConversationOwner", fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([projectId, branchId, updatedAt(sort: Desc)])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("ai_conversations")
}

// Single prompt, response, or reasoning turn inside an AI assistant conversation
model AiMessage {
  id               String        @id @default(uuid())
  conversationId   String
  role             AiMessageRole @default(USER)
  actionKind       AiActionKind  @default(CHAT)
  content          String        @db.Text
  model            String?
  promptTokens     Int?
  completionTokens Int?
  fileId           String?
  fileName         String?
  lineStart        Int?
  lineEnd          Int?
  suggestedCode    String?       @db.Text
  createdAt        DateTime      @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  file         ProjectFile?   @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt(sort: Asc)])
  @@index([fileId])
  @@map("ai_messages")
}

// Semantic vector embedding for a chunk of code in a project file
model CodebaseEmbedding {
  id          String                      @id @default(uuid())
  projectId   String
  branchId    String
  fileId      String
  filePath    String
  chunkIndex  Int
  startLine   Int
  endLine     Int
  content     String                      @db.Text
  contentHash String                      @db.VarChar(64)
  tokenCount  Int
  embedding   Unsupported("vector(768)")?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  branch  ProjectBranch @relation(fields: [branchId, projectId], references: [id, projectId], onDelete: Cascade)
  file    ProjectFile   @relation(fields: [fileId, branchId], references: [id, branchId], onDelete: Cascade)

  @@unique([fileId, chunkIndex])
  @@index([projectId, branchId])
  @@index([fileId])
  @@index([contentHash])
  @@map("codebase_embeddings")
}

// Asynchronous indexing task tracker for multi-file semantic embeddings
model CodebaseIndexTask {
  id            String          @id @default(uuid())
  projectId     String
  branchId      String
  requestedById String
  status        IndexTaskStatus @default(PENDING)
  totalFiles    Int             @default(0)
  indexedFiles  Int             @default(0)
  totalChunks   Int             @default(0)
  errorMessage  String?         @db.Text
  startedAt     DateTime?
  completedAt   DateTime?
  retryCount    Int             @default(0)
  maxRetries    Int             @default(3)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  branch      ProjectBranch @relation(fields: [branchId, projectId], references: [id, projectId], onDelete: Cascade)
  requestedBy User          @relation("IndexTaskRequester", fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([projectId, branchId, createdAt(sort: Desc)])
  @@map("codebase_index_tasks")
}

// =====================================================================
// Day 8: Multi-File Autonomous Agent Workflows & Self-Healing Models
// Tracks autonomous multi-turn sessions, plan decomposition steps,
// detailed tool execution logs, and quarantined staged file mutations.
// =====================================================================

// Top-level autonomous agent refactoring or migration session
model AgentSession {
  id                     String             @id @default(uuid())
  projectId              String
  branchId               String
  userId                 String
  title                  String             @default("Multi-File Refactor")
  prompt                 String             @db.Text
  status                 AgentSessionStatus @default(PLANNING)
  model                  String             @default("gemini-1.5-pro")
  totalInputTokens       Int                @default(0)
  totalOutputTokens      Int                @default(0)
  selfHealingAttempts    Int                @default(0)
  maxSelfHealingAttempts Int                @default(3)
  errorMessage           String?            @db.Text
  expiresAt              DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  branch      ProjectBranch     @relation(fields: [branchId, projectId], references: [id, projectId], onDelete: Cascade)
  user        User              @relation("AgentSessionOwner", fields: [userId], references: [id], onDelete: Cascade)
  steps       AgentPlanStep[]
  toolCalls   AgentToolCall[]
  stagedFiles AgentStagedFile[]

  @@index([projectId, branchId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("agent_sessions")
}

// Discrete execution milestone produced by agent planning
model AgentPlanStep {
  id           String          @id @default(uuid())
  sessionId    String
  stepNumber   Int
  title        String
  description  String          @db.Text
  status       AgentStepStatus @default(PENDING)
  errorMessage String?         @db.Text
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, stepNumber])
  @@index([sessionId, stepNumber(sort: Asc)])
  @@map("agent_plan_steps")
}

// Audit record of an autonomous tool execution
model AgentToolCall {
  id            String          @id @default(uuid())
  sessionId     String
  stepId        String?
  toolName      String
  inputPayload  Json
  outputPayload Json?
  status        AgentToolStatus @default(RUNNING)
  errorMessage  String?         @db.Text
  durationMs    Int?
  createdAt     DateTime        @default(now())

  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt(sort: Asc)])
  @@map("agent_tool_calls")
}

// Quarantined file mutation buffer awaiting developer review & atomic application
model AgentStagedFile {
  id              String              @id @default(uuid())
  sessionId       String
  fileId          String?
  filePath        String
  changeType      AgentFileChangeType @default(MODIFY)
  originalContent     String?             @db.Text
  stagedContent       String              @db.Text
  originalVersion     Int?
  originalContentHash String?             @db.VarChar(64)
  isApplied           Boolean             @default(false)
  hasConflict         Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, filePath])
  @@index([sessionId])
  @@map("agent_staged_files")
}

// Day 9: Developer Sandbox container states
enum SandboxStatus {
  STARTING
  RUNNING
  STOPPING
  STOPPED
  FAILED
}

// Day 9: Dedicated developer sandbox container instance running on private Docker network
model PreviewSandbox {
  id            String        @id @default(uuid())
  projectId     String
  branchId      String
  containerId   String?       @db.VarChar(128)
  containerName String        @db.VarChar(128)
  internalIp    String?       @db.VarChar(64)
  status        SandboxStatus @default(STARTING)
  ports         Int[]         @default([5173])
  primaryPort   Int           @default(5173)
  memoryLimitMb Int           @default(512)
  cpuLimit      Float         @default(1.0)
  previewToken  String?       @db.Text
  errorMessage  String?       @db.Text
  lastPingAt    DateTime?
  startedAt     DateTime?
  stoppedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  branch  ProjectBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([projectId, branchId])
  @@index([projectId, status])
  @@map("preview_sandboxes")
}
